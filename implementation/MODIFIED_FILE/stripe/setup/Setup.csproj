<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>StripeOnSurfaceSetup</AssemblyName>
    <RootNamespace>StripeOnSurfaceSetup</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\out\setup\</OutputPath>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>CS0618</NoWarn>
    <Product>表面条纹插件安装程序</Product>
    <AssemblyTitle>表面条纹插件安装程序</AssemblyTitle>
    <Version>1.0.0</Version>
    <Company>Lab</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload\StripeOnSurface-rh7.rhp" LogicalName="p_rh7" />
    <EmbeddedResource Include="payload\StripeOnSurface-rh8.rhp" LogicalName="p_rh8" />
    <EmbeddedResource Include="payload\StripeOnSurface.rui" LogicalName="p_rui" />
  </ItemGroup>

</Project>
