<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>StripeOnSurface</AssemblyName>
    <RootNamespace>StripeOnSurface</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\out\rhino7\</OutputPath>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>表面条纹生成器 (Surface Stripe)</Product>
    <Company>Lab</Company>
    <Version>1.0.0</Version>
    <AssemblyTitle>StripeOnSurface</AssemblyTitle>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 用 Rhino 7 最早期 SDK（7.0 SR0）编译：任何 7.x 都能加载，而不是只在最新 7.38 上可用 -->
    <PackageReference Include="RhinoCommon" Version="7.0.20314.3001" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Compile Include="..\src\**\*.cs" />
  </ItemGroup>

  <Target Name="CopyRhp" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)StripeOnSurface.rhp" ContinueOnError="true" />
  </Target>

</Project>
