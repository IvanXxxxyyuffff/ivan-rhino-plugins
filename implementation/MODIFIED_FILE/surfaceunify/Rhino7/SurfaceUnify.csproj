<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SurfaceUnify</AssemblyName>
    <RootNamespace>SurfaceUnifyPattern</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\out\rhino7\</OutputPath>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>RH7</DefineConstants>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>多重曲面转单一曲面 (Surface Unify)</Product>
    <Company>IVAN</Company>
    <Version>1.0.0</Version>
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 用 Rhino 7 最早期 SDK 编译：所有 7.x 都能加载 -->
    <PackageReference Include="RhinoCommon" Version="7.0.20314.3001" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Compile Include="..\src\**\*.cs" />
  </ItemGroup>

  <Target Name="CopyRhp" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)SurfaceUnify.rhp" ContinueOnError="true" />
  </Target>

</Project>
